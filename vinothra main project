CSS PROGRAM
          
/* ==========================================
   GLOBAL RESET & FONTS
========================================== */
body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #121212;
    color: #ffffff;
    overflow-x: hidden;
}

/* ==========================================
   DISPLAY & POSITION PROPERTIES
========================================== */
.custom-nav {
    display: flex;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(18, 18, 18, 0.95) !important;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.hero-section {
    display: flex;
    position: relative;
    height: 100vh;
    background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.8)), 
                url('https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=1920&q=80') no-repeat center center/cover;
}

/* ==========================================
   KEYFRAME ANIMATIONS
========================================== */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-pop {
    animation: fadeInUp 1s ease-out forwards;
}

.animate-fade {
    animation: fadeInUp 1.4s ease-out forwards;
}

/* ==========================================
   GYM CARD STYLING (Image, Shadows, Radius)
========================================== */
.gym-card {
    position: relative;
    border-radius: 16px;            /* Border Radius */
    overflow: hidden;
    background-color: #1e1e1e;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4); /* Type 1: Soft Ambient Shadow */
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); /* Transition Properties */
}

/* Image wrapper config */
.card-img-wrapper {
    width: 100%;
    height: 320px;
    overflow: hidden;
}

.card-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease; /* Smooth zoom transition */
}

/* ==========================================
   HOVER EFFECTS & TRANSFORMS
========================================== */
.gym-card:hover {
    transform: translateY(-12px); /* Transform property: Lift up */
    /* Type 2: Colored Glowing Shadow on Hover */
    box-shadow: 0 15px 35px rgba(220, 53, 69, 0.4), 
                0 5px 15px rgba(0, 0, 0, 0.8); 
}

.gym-card:hover .card-img-wrapper img {
    transform: scale(1.12); /* Transform property: Zoom-in */
}

/* Overlay Position and Display setup */
.card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 25px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 20%, rgba(0, 0, 0, 0.2) 80%);
    opacity: 0.85;
    transition: opacity 0.3s ease;
}

.gym-card:hover .card-overlay {
    opacity: 1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.95) 40%, rgba(220, 53, 69, 0.3) 100%);
}

.card-overlay h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 5px;
    transition: transform 0.3s ease;
}

.gym-card:hover .card-overlay h3 {
    transform: translateY(-5px);
}

.card-overlay p {
    font-size: 0.85rem;
    color: #cccccc;
    margin-bottom: 10px;
}

/* ==========================================
   BUTTON STYLING & TRANSITIONS
========================================== */
.custom-btn, .btn-reservation, .custom-submit-btn {
    border-radius: 50px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
}

.custom-btn:hover, .btn-reservation:hover, .custom-submit-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 20px rgba(220, 53, 69, 0.6);
}

     

















          





          
