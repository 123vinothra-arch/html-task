CSS PROGRAM

body {
    background-color: black;
    font-family: Arial;
}

.biodata {
    width: 500px;
    margin: 100px auto;
    padding: 25px;
    background-color: white;
    border-radius: 10px;
    
    animation-name: biodataAnimation;
    animation-duration: 2s;
    animation-iteration-count: infinite;
}

h1 {
    text-align: center;
}

@keyframes biodataAnimation {
    0% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-20px);
    }

    100% {
        transform: translateY(0);
    }
}



















