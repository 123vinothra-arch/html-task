html program

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gym Reservation Website</title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    
    <link rel="stylesheet" href="student.css">
</head>
<body>

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">FitZone Gym</a>
        </div>
    </nav>

    <section class="hero">
        <h1>Welcome to FitZone Gym</h1>
        <p>Keep Your Body Fit and Healthy!</p>
        <a href="#booking" class="btn btn-danger">Book Now</a>
    </section>

    <div class="container my-5">
        <h2 class="text-center">Our Services</h2>

        <div class="row mt-4">
            <div class="col-md-4 mb-3">
                <div class="card p-3 text-center">
                    <h3>🏋️ Workout</h3>
                    <p>Daily Gym Training</p>
                </div>
            </div>


            <div class="col-md-4 mb-3">
                <div class="card p-3 text-center">
                    <h3>🧘 Yoga</h3>
                    <p>Yoga Training</p>
          
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card p-3 text-center">
                    <h3>🏃 Cardio</h3>
                    <p>Fitness Training</p>
                </div>
            </div>
    
            

    <div class="container mb-5" id="booking">
        <h2 class="text-center">Gym Reservation</h2>

        <form class="booking-form">
            <label class="form-label">Your Name</label>
            <input type="text" class="form-control mb-3"
                   placeholder="Enter your name" required>

            <label class="form-label">Email</label>
            <input type="email" class="form-control mb-3"
                   placeholder="Enter your email" required>

            <label class="form-label">Select Date</label>
            <input type="date" class="form-control mb-3" required>

            <label class="form-label">Select Plan</label>
            <select class="form-select mb-3" required>
                <option value="">Choose a plan</option>
                <option>Basic - ₹500</option>
                <option>Standard - ₹1000</option>
                <option>Premium - ₹1500</option>
            </select>

            <button type="submit" class="btn btn-danger w-100">
                Reserve Now
            </button>
        </form>
    </div>

    <footer>
        <p>© 2026 FitZone Gym</p>
    </footer>

</body>
</html>

css program

body {
    font-family: Arial, sans-serif;
    background-color:white;
    margin: 0;
}

.navbar-brand {
    font-size: 25px;
    font-weight: bold;
}

.hero {
    background-color: #a5a6ad;
    color: white;
    text-align: center;
    padding: 60px 20px;
}

.hero h1 {
    color: #ff4757;
    font-size: 36px;
}

.hero p {
    font-size: 18px;
}

h2 {
    color: #dc3545;
    margin-bottom: 20px;
}

.card {
    border: none;
    box-shadow: 0 4px 8px #cccccc;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}


.booking-form {
    background-color: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 4px 8px #cccccc;
    max-width: 600px;
    margin: auto;
}

footer {
    background-color: black;
    color: white;
    text-align: center;
    padding: 15px;
}












