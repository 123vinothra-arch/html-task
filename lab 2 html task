!DOCTYPE html>
<html>
<head>
    <title>Registration Form</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="form-container">
    <h2>Registration Form</h2>

    <form>
        <label>First Name:</label>
        <input type="text" placeholder="Enter your first name">

        <label>Last Name:</label>
        <input type="text" placeholder="Enter your last name">

        <label>Nick Name:</label>
        <input type="text" placeholder="Enter your nick name">

        <label>E-mail:</label>
        <input type="email" placeholder="Enter your email">

        <label>Password:</label>
        <input type="password" placeholder="Enter your password">

        <label>Date of Birth:</label>
        <input type="date">

        <label>Gender:</label>
        <div class="options">
            <input type="radio" name="gender"> Male
            <input type="radio" name="gender"> Female
            <input type="radio" name="gender"> Others
        </div>

        <label>Mobile:</label>
        <input type="tel" placeholder="Enter your mobile number">

        <label>Address:</label>
        <textarea placeholder="Enter your address"></textarea>

        <label>Eye Color:</label>
        <select>
            <option>Select</option>
            <option>Green</option>
            <option>Blue</option>
            <option>Brown</option>
            <option>Black</option>
        </select>

        <label>Check all that apply:</label>
        <div class="checkbox">
            <input type="checkbox"> Over 6 feet tall<br>
            <input type="checkbox"> Over 200 pounds
        </div>

        <label>Describe your athletic ability:</label>
        <textarea placeholder="Enter your information"></textarea>

        <button type="submit">Enter My Information</button>
    </form>
</div>

</body>
</html>
