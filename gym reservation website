HTML PROGRAM
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gym Fitness Website</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- External CSS -->
    <link rel="stylesheet" href="student.css">
</head>

<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="#">🏋️ FFL</a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav mx-auto">
                <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="#about">About Us</a></li>
                <li class="nav-item"><a class="nav-link" href="#services">Services</a></li>
                <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
            </ul>

            <a href="#contact" class="btn orange-btn">Free Trial</a>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section class="hero" id="home">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-md-6">
                <p class="small-title">WELCOME TO OUR FITNESS CLUB</p>

                <h1>Push Your<br>
                    <span>Limits with Us</span>
                </h1>

                <p class="description">
                    From beginner to advanced, experience workouts
                    designed to help you achieve peak performance
                    and reach your fitness goals.
                </p>

                <a href="#contact" class="btn orange-btn">
                    Join Now »
                </a>

                <a href="#services" class="watch-link">
                    ▶ Watch Services
                </a>

                <div class="mt-4">
                    <span class="tag">Personal Training</span>
                    <span class="tag">Strength</span>
                    <span class="tag">Cardio Fitness</span>
                </div>
            </div>

            <div class="col-md-6 text-center">
                <img
                  src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=900&q=85"
                  class="runner-img"
                  alt="Gym fitness training">
            </div>

        </div>
    </div>
</section>

<!-- About Section -->
<section class="section" id="about">
    <div class="container text-center">
        <h2>About <span>Our Gym</span></h2>
        <p>
            We help people build strength, improve fitness,
            and achieve a healthy lifestyle.
        </p>
    </div>
</section>

<!-- Services Section -->
<section class="section services" id="services">
    <div class="container">
        <h2 class="text-center mb-4">Our Services</h2>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="service-card">
                    <h3>💪 Strength Training</h3>
                    <p>Build your muscles and improve your strength.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="service-card">
                    <h3>🏃 Cardio Fitness</h3>
                    <p>Improve your stamina and overall fitness.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="service-card">
                    <h3>🧘 Personal Training</h3>
                    <p>Get guidance for your personal fitness goals.</p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Contact / Reservation Section -->
<section class="section" id="contact">
    <div class="container">
        <h2 class="text-center mb-4">Book Your Free Trial</h2>

        <form class="booking-form" onsubmit="bookTrial(event)">
            <input type="text" class="form-control mb-3"
                   placeholder="Enter your name" required>

            <input type="email" class="form-control mb-3"
                   placeholder="Enter your email" required>

            <select class="form-select mb-3" required>
                <option value="">Select a training plan</option>
                <option>Strength Training</option>
                <option>Cardio Fitness</option>
                <option>Personal Training</option>
            </select>

            <input type="date" class="form-control mb-3" required>

            <button type="submit" class="btn orange-btn w-100">
                Book Now
            </button>
        </form>

        <p id="message" class="text-center mt-3"></p>
    </div>
</section>

<footer>
    <p>© 2026 FFL Fitness Club | All Rights Reserved</p>
</footer>

<script>
function bookTrial(event) {
    event.preventDefault();
    document.getElementById("message").textContent =
        "Your trial request has been submitted!";
}
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
CSS PROGRAM
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #17100e;
    color: white;
    font-family: Arial, sans-serif;
}

/* Navbar */
.navbar {
    background-color: #211613;
    padding: 18px 0;
}

.navbar-brand {
    color: #ff5722;
    font-weight: bold;
    font-size: 26px;
}

.nav-link {
    color: white;
    margin: 0 10px;
}

.nav-link:hover {
    color: #ff5722;
}

/* Orange Button */
.orange-btn {
    background-color: #ff472e;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 30px;
    font-weight: bold;
}

.orange-btn:hover {
    background-color: #e63820;
    color: white;
}

/* Hero Section */
.hero {
    padding: 65px 0;
    background: linear-gradient(120deg, #211613, #4b1d0c);
}

.small-title {
    color: #ff7043;
    letter-spacing: 2px;
    font-size: 12px;
}

h1 {
    font-size: clamp(38px, 5vw, 60px);
    font-weight: 900;
    margin: 20px 0;
}

h1 span,
h2 span {
    color: #ff5722;
}

.description {
    color: #d1c4c0;
    line-height: 1.8;
    max-width: 450px;
}

.watch-link {
    color: white;
    text-decoration: none;
    margin-left: 15px;
}

.runner-img {
    width: 100%;
    max-width: 450px;
    height: 420px;
    object-fit: cover;
    border-radius: 20px;
}

/* Tags */
.tag {
    display: inline-block;
    border: 1px solid #725044;
    padding: 8px 12px;
    margin: 5px;
    border-radius: 20px;
    font-size: 12px;
}

/* Sections */
.section {
    padding: 60px 0;
}

.section h2 {
    font-weight: bold;
    margin-bottom: 20px;
}

.services {
    background-color: #211613;
}

.service-card {
    background-color: #35231e;
    padding: 25px;
    border-radius: 15px;
    height: 100%;
    border: 1px solid #59392e;
}

.service-card h3 {
    font-size: 21px;
    color: #ff7043;
    margin-bottom: 15px;
}

.service-card p {
    color: #d1c4c0;
}

/* Booking Form */
.booking-form {
    max-width: 500px;
    margin: auto;
}

.form-control,
.form-select {
    padding: 12px;
    background-color: #2c211e;
    color: white;
    border: 1px solid #60473e;
}

.form-control::placeholder {
    color: #c9b9b3;
}

.form-control:focus,
.form-select:focus {
    background-color: #2c211e;
    color: white;
    border-color: #ff5722;
    box-shadow: none;
}

.form-select option {
    background-color: #2c211e;
    color: white;
}

footer {
    background-color: #0d0908;
    text-align: center;
    padding: 20px;
    color: #c9b9b3;
}

/* Mobile Responsive */
@media (max-width: 767px) {
    .hero {
        padding: 40px 0;
    }

    .runner-img {
        height: 300px;
        margin-top: 30px;
    }

    .watch-link {
        display: inline-block;
        margin-top: 15px;
    }
}















</html>
