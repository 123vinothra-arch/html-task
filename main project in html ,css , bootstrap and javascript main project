CSS PROGRAM

/* 1. Universal Selector */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f2f2f2;
    color: #212529;
}

/* 2. Position Property */
.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar-brand {
    color: #ff4757;
    font-weight: bold;
}

/* 3. Hero Section */
.hero {
    min-height: 400px;
    background-image:
        linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
        url("images/Downloads/danielle-cerullo-CQfNt66ttZM-unsplash.jpg");
    background-size: cover;
    background-position: center;

    display: flex;
    justify-content: center;
    align-items: center;

    position: relative;
    overflow: hidden;
}

.hero-content {
    color: white;
    text-align: center;
    padding: 20px;
    animation: slideIn 1.5s ease;
}

.hero h1 {
    font-size: 40px;
    text-shadow: 3px 3px 5px black;
}

.hero p {
    margin: 15px 0;
    font-size: 18px;
}

/* Animation */
@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(40px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 4. Gym Cards */
.gym-card {
    background-color: white;
    padding: 15px;
    text-align: center;
    border-radius: 15px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);

    transition: transform 0.4s ease,
                box-shadow 0.4s ease;

    position: relative;
    height: 100%;
}

.gym-card img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 15px;
    transition: transform 0.4s ease;
}

.gym-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 12px 25px rgba(0,0,0,0.35);
}

.gym-card img:hover {
    transform: scale(1.05);
}

.gym-card h4 {
    color: #ff4757;
}

/* Button Hover */
.btn-danger {
    background-color: #ff4757;
    border-color: #ff4757;
    transition: transform 0.3s ease,
                box-shadow 0.3s ease;
}

.btn-danger:hover {
    background-color: #e63748;
    border-color: #e63748;
    transform: scale(1.05);
    box-shadow: 0 5px 12px rgba(255,71,87,0.5);
}

/* 5. Reservation Form */
.reservation-section {
    background-color: #212529;
}

.reservation-box {
    background-color: white;
    max-width: 600px;
    margin: auto;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);
    display: block;
    position: relative;
}

.reservation-box input:focus,
.reservation-box select:focus {
    border-color: #ff4757;
    box-shadow: inset 0 0 5px rgba(255,71,87,0.3);
}

.reservation-box h2 {
    color: #ff4757;
    text-shadow: 1px 1px 2px #aaaaaa;
}

.reservation-box label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
}

/* 6. Responsive Design */
@media (max-width: 576px) {
    .hero h1 {
        font-size: 28px;
    }

    .gym-card img {
        height: 200px;
    }

    .reservation-box {
        padding: 20px;
    }
}

JAVASCRIPT PROGRAM

const form = document.getElementById("reservationForm");
const message = document.getElementById("message");
const dateInput = document.getElementById("date");

// Today's date
function getToday() {
    const today = new Date();

    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, "0");
    const day = String(today.getDate()).padStart(2, "0");

    return `${year}-${month}-${day}`;
}

// Prevent past date selection
dateInput.min = getToday();

// Read saved reservations
function getBookings() {
    try {
        return JSON.parse(
            localStorage.getItem("fitZoneBookings") || "[]"
        );
    } catch (error) {
        return [];
    }
}

// Display success or error message
function showMessage(text, type) {
    message.className = `alert alert-${type} mt-4`;
    message.textContent = text;
}

// Form submit event
form.addEventListener("submit", function (event) {

    // Prevent page refresh
    event.preventDefault();

    // Get form values
    const name = document.getElementById("name").value.trim();
    const email = document.getElementById("email").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const service = document.getElementById("service").value;
    const date = dateInput.value;
    const time = document.getElementById("time").value;

    // Validate name
    if (name.length < 2) {
        showMessage("Please enter your full name.", "danger");
        return;
    }

    // Validate mobile number
    if (!/^[6-9][0-9]{9}$/.test(phone)) {
        showMessage(
            "Please enter a valid 10-digit mobile number.",
            "danger"
        );
        return;
    }

    // Validate date
    if (!date || date < getToday()) {
        showMessage(
            "Please select today or a future date.",
            "danger"
        );
        return;
    }

    // Read existing reservations
    const bookings = getBookings();

    // Check duplicate date and time
    const alreadyBooked = bookings.some(function (booking) {
        return booking.date === date && booking.time === time;
    });

    if (alreadyBooked) {
        showMessage(
            "This time slot is already booked in this browser. Choose another time.",
            "danger"
        );
        return;
    }

    // Create reservation object
    const booking = {
        bookingId: "FIT" + Date.now(),
        name: name,
        email: email,
        phone: phone,
        service: service,
        date: date,
        time: time
    };

    // Save reservation
    try {
        bookings.push(booking);

        localStorage.setItem(
            "fitZoneBookings",
            JSON.stringify(bookings)
        );
    } catch (error) {
        showMessage(
            "Unable to save booking. Please check browser storage.",
            "danger"
        );
        return;
    }

    // Show confirmation
    showMessage(
        `Reservation Successful! Welcome ${name}. ` +
        `Service: ${service}. Date: ${date}. Time: ${time}. ` +
        `Booking ID: ${booking.bookingId}`,
        "success"
    );

    // Clear form
    form.reset();

    // Keep past dates disabled
    dateInput.min = getToday();
});















