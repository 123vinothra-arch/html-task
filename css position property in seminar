CSS PROGRAM

body {
    font-family: Arial;
    height: 1200px;
}
.static {
    position: static;
    background: lightblue;
    padding: 20px;
    margin: 10px;
}
.relative {
    position: relative;
    left: 50px;
    background: lightgreen;
    padding: 20px;
    margin: 10px;
}
.parent {
    position: relative;
    background: orange;
    width: 300px;
    height: 150px;
    margin: 20px;
    padding: 20px;
}
.absolute {
    position: absolute;
    left: 50px;
    right: 20px;
    background: pink;
    padding: 20px;
}
.fixed{
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: red;
    color: white;
    padding: 15px;
}
.sticky {
    position: sticky;
    top: 0;
    background: yellow;
    padding: 20px;
}

















