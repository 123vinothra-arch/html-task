HTML PROGRAM

/* 1. Universal Selector */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f2f2f2;
    color: #212529;
}

/* 2. Position Property */
.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar-brand {
    color: #ff4757;
    font-weight: bold;
}

/* 3. Hero Section */
.hero {
    height: 400px;
    background-image:
    linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
    url("/images/Downloads/danielle-cerullo-CQfNt66ttZM-unsplash.jpg");
    background-size: cover;
    background-position: center;

    /* Display Property */
    display: flex;
    justify-content: center;
    align-items: center;

    position: relative;
    overflow: hidden;
}

/* 4. Animation Property */
.hero-content {
    color: white;
    text-align: center;
    padding: 20px;
    animation: slideIn 1.5s ease;
}

.hero h1 {
    font-size: 40px;

    /* Text Shadow */
    text-shadow: 3px 3px 5px black;
}

.hero p {
    margin: 15px 0;
    font-size: 18px;
}

/* Keyframes Animation */
@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 5. Gym Cards */
.gym-card {
    background-color: white;
    padding: 15px;
    text-align: center;

    /* Border Radius */
    border-radius: 15px;

    /* Box Shadow */
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);

    /* Transition */
    transition: transform 0.4s ease,
                box-shadow 0.4s ease;

    position: relative;
}

/* Image Style */
.gym-card img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 15px;

    transition: transform 0.4s ease;
}

/* 6. Hover and Transform */
.gym-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 12px 25px rgba(0,0,0,0.35);
}

.gym-card img:hover {
    transform: scale(1.05);
}

.gym-card h4 {
    color: #ff4757;
}

/* Button Hover */
.btn-danger {
    transition: transform 0.3s ease,
                box-shadow 0.3s ease;
}

.btn-danger:hover {
    transform: scale(1.05);
    box-shadow: 0 5px 12px rgba(255,71,87,0.5);
}

/* 7. Reservation Form */
.reservation-section {
    background-color: #212529;
}

.reservation-box {
    background-color: white;
    max-width: 600px;
    margin: auto;
    padding: 30px;
    border-radius: 15px;

    /* Box Shadow */
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);

    /* Display and Position */
    display: block;
    position: relative;
}

/* Inset Shadow Example */
.reservation-box input:focus,
.reservation-box select:focus {
    border-color: #ff4757;
    box-shadow: inset 0 0 5px rgba(255,71,87,0.3);
}

.reservation-box h2 {
    color: #ff4757;
    text-shadow: 1px 1px 2px #aaaaaa;
}

.reservation-box label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
}

/* 8. Responsive Design */
@media (max-width: 576px) {
    .hero h1 {
        font-size: 28px;
    }

    .gym-card img {
        height: 200px;
    }

    .reservation-box {
        padding: 20px;
    }
}













  
